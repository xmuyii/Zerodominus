# ⚠️ IMPORTANT: This is a TEMPLATE - replace placeholders with your real credentials
# NEVER commit .env to GitHub - it should only exist locally in your workspace

# Telegram Bot (Production) - Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Telegram Test Bot (Optional) - Create a new bot via @BotFather: /newbot → name it "The64_Test"
TEST_BOT_TOKEN=your_test_bot_token_here

# Supabase Configuration - Get from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
LICHESS_API_KEY=your_token_here
# Database Configuration
DATABASE_TABLE=players
ENV_NAME=PRODUCTION

# Group Chat Configuration (Required for Announcements)
# To get your group chat ID:
# 1. Add the bot to your group
# 2. In group, send /getchatid
# 3. Bot will reply with the chat ID (negative number like -1001234567890)
CHECKMATE_HQ_GROUP_ID=-1001234567890